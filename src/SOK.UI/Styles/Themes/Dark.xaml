<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Tema oscuro de SOK. Conserva las mismas claves que Light.xaml. -->

    <Color x:Key="SidebarColor">#020617</Color>
    <Color x:Key="SidebarHoverColor">#0F172A</Color>
    <Color x:Key="SidebarActiveColor">#60A5FA</Color>
    <Color x:Key="AccentColor">#60A5FA</Color>
    <Color x:Key="AccentHoverColor">#93C5FD</Color>
    <Color x:Key="AccentSubtleColor">#172554</Color>
    <Color x:Key="BackgroundColor">#0B1120</Color>
    <Color x:Key="CardColor">#111827</Color>
    <Color x:Key="SurfaceSubtleColor">#1E293B</Color>
    <Color x:Key="SurfaceHoverColor">#1E293B</Color>
    <Color x:Key="TextPrimaryColor">#F8FAFC</Color>
    <Color x:Key="TextSecondaryColor">#CBD5E1</Color>
    <Color x:Key="TextTertiaryColor">#94A3B8</Color>
    <Color x:Key="BorderColor">#1E293B</Color>
    <Color x:Key="BorderSubtleColor">#334155</Color>
    <Color x:Key="SuccessColor">#10B981</Color>
    <Color x:Key="SuccessSubtleColor">#022C22</Color>
    <Color x:Key="WarningColor">#F59E0B</Color>
    <Color x:Key="WarningSubtleColor">#451A03</Color>
    <Color x:Key="DangerColor">#F43F5E</Color>
    <Color x:Key="DangerHoverColor">#FB7185</Color>
    <Color x:Key="DangerSubtleColor">#4C0519</Color>

    <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarColor}" />
    <SolidColorBrush x:Key="SidebarHoverBrush" Color="{StaticResource SidebarHoverColor}" />
    <SolidColorBrush x:Key="SidebarActiveBrush" Color="{StaticResource SidebarActiveColor}" />
    <SolidColorBrush x:Key="SidebarTextBrush" Color="#CBD5E1" />
    <SolidColorBrush x:Key="SidebarTextMutedBrush" Color="#94A3B8" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="{StaticResource AccentSubtleColor}" />
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}" />
    <SolidColorBrush x:Key="SurfaceSubtleBrush" Color="{StaticResource SurfaceSubtleColor}" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiaryColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource BorderSubtleColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="SuccessSubtleBrush" Color="{StaticResource SuccessSubtleColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="WarningSubtleBrush" Color="{StaticResource WarningSubtleColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="DangerHoverBrush" Color="{StaticResource DangerHoverColor}" />
    <SolidColorBrush x:Key="DangerSubtleBrush" Color="{StaticResource DangerSubtleColor}" />

</ResourceDictionary>
