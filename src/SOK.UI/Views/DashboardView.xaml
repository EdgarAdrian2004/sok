<UserControl x:Class="SOK.UI.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="clr-namespace:SOK.UI.Converters"
             mc:Ignorable="d"
             d:DesignHeight="700"
             d:DesignWidth="960">
    <UserControl.Resources>
        <converters:IconKeyToGeometryConverter x:Key="IconKeyToGeometryConverter" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <!-- Hero -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Tu equipo está en buen estado"
                               Style="{StaticResource PageTitle}" />
                    <TextBlock Text="Resumen del estado del sistema y acciones rápidas."
                               Style="{StaticResource BodyText}"
                               Margin="0,6,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding LastUpdatedText}" Style="{StaticResource SmallText}" />
                </StackPanel>
            </Grid>

            <!-- Franja de métricas -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,12,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Path Data="{StaticResource IconCpu}" Width="16" Height="16"
                                  Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.75"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Fill="Transparent" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Uso de CPU" Style="{StaticResource BodyText}" />
                        </StackPanel>
                        <TextBlock Text="{Binding CpuUsageText}" Style="{StaticResource MetricValue}" Margin="0,6,0,0" />
                        <ProgressBar Value="{Binding CpuUsage}" Maximum="100"
                                     Style="{StaticResource SokProgressBar}" Margin="0,14,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardBorder}" Margin="6,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Path Data="{StaticResource IconCpu}" Width="16" Height="16"
                                  Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.75"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Fill="Transparent" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Memoria RAM" Style="{StaticResource BodyText}" />
                        </StackPanel>
                        <TextBlock Text="{Binding RamUsageText}" Style="{StaticResource MetricValue}" Margin="0,6,0,0" />
                        <ProgressBar Value="{Binding RamUsagePercent}" Maximum="100"
                                     Style="{StaticResource SokProgressBar}" Margin="0,14,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardBorder}" Margin="12,0,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Path Data="{StaticResource IconDrive}" Width="16" Height="16"
                                  Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.75"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Fill="Transparent" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Disco del sistema" Style="{StaticResource BodyText}" />
                        </StackPanel>
                        <TextBlock Text="{Binding DiskUsageText}" Style="{StaticResource MetricValue}" Margin="0,6,0,0" />
                        <TextBlock Text="GB libres / totales" Style="{StaticResource SmallText}" Margin="0,2,0,0" />
                        <ProgressBar Value="{Binding DiskUsagePercent}" Maximum="100"
                                     Style="{StaticResource SokProgressBar}" Margin="0,14,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Equipo y actividad -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="Equipo" Style="{StaticResource SectionTitle}" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Path Data="{StaticResource IconMonitor}" Width="16" Height="16"
                                  Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.75"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Fill="Transparent" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding MachineName}" Style="{StaticResource BodyText}" />
                        </StackPanel>
                        <TextBlock Text="{Binding OsName}" Style="{StaticResource BodyText}" Margin="24,4,0,0" />
                        <TextBlock Text="{Binding ProcessorName}" Style="{StaticResource BodyText}" Margin="24,4,0,0" />
                        <TextBlock Text="{Binding UptimeText}" Style="{StaticResource SmallText}" Margin="24,8,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardBorder}" Margin="12,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Acciones rápidas" Style="{StaticResource SectionTitle}" />
                        <StackPanel Margin="0,10,0,0">
                            <Button Content="Actualizar panel" Command="{Binding RefreshNowCommand}"
                                    Style="{StaticResource SecondaryButton}" Margin="0,0,0,8" HorizontalAlignment="Left" />
                            <Button Content="Crear respaldo completo" Command="{Binding CreateBackupCommand}"
                                    Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" />
                        </StackPanel>
                        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource BodyText}" Margin="0,16,0,0" />
                        <TextBlock Text="{Binding LastBackupPath}" Style="{StaticResource SmallText}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Respaldos -->
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="Respaldos" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="Antes de aplicar cualquier cambio, SOK exporta el registro de Windows y el estado de los servicios."
                               Style="{StaticResource BodyText}" Margin="0,8,0,0" />
                    <Border Style="{StaticResource InfoBarInfo}" Margin="0,12,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconInfo}" Width="16" Height="16"
                                  Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.75"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Fill="Transparent" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="La regla de oro de SOK: toda modificación genera un respaldo previo."
                                       Style="{StaticResource BodyText}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>