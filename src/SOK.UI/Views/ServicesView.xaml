<UserControl x:Class="SOK.UI.Views.ServicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:enums="clr-namespace:SOK.Domain.Enums;assembly=SOK.Domain"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="900">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <ScrollViewer x:Name="ContentScroll" VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <!-- Encabezado y acciones -->
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="SOK revisa los servicios no esenciales de Windows. Cada cambio crea un respaldo en JSON antes de detener o deshabilitar el servicio."
                               Style="{StaticResource BodyText}" />

                    <TextBlock Text="{Binding SummaryText}"
                               Style="{StaticResource SectionTitle}"
                               Margin="0,14,0,0" />

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,12,0,0">
                        <ComboBox ItemsSource="{Binding Categories}"
                                  SelectedItem="{Binding SelectedCategory}"
                                  Width="180"
                                  Height="34"
                                  Margin="0,0,12,0" />
                        <Button Content="Actualizar"
                                Command="{Binding RefreshCommand}"
                                Style="{StaticResource SecondaryButton}"
                                Margin="0,0,12,0" />
                        <Button Content="Perfil Gamer"
                                Command="{Binding ApplyGamerProfileCommand}"
                                Style="{StaticResource PrimaryButton}"
                                Margin="0,0,8,0" />
                        <Button Content="Perfil Ofimático"
                                Command="{Binding ApplyOfimaticoProfileCommand}"
                                Style="{StaticResource PrimaryButton}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Estado de la última operación -->
            <Border Style="{StaticResource CardBorder}"
                    Margin="0,16,0,0"
                    Padding="16">
                <StackPanel>
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource BodyText}" />
                    <TextBlock Text="{Binding LastBackupText}"
                               Style="{StaticResource SmallText}"
                               Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- Criterio de los perfiles -->
            <Border Style="{StaticResource CardBorder}"
                    Margin="0,16,0,0"
                    Padding="16">
                <StackPanel>
                    <TextBlock Text="Criterio de los perfiles" Style="{StaticResource SectionTitle}" />
                    <TextBlock Style="{StaticResource BodyText}"
                               Margin="0,6,0,0"
                               Text="Los perfiles son conservadores: nunca deshabilitan Bluetooth, Windows Search, Windows Hello, impresión, soporte remoto ni las aplicaciones nativas de Windows. Los servicios de alto riesgo solo pueden cambiarse manualmente." />
                </StackPanel>
            </Border>

            <!-- Catálogo agrupado por categoría -->
            <ItemsControl ItemsSource="{Binding Groups}" Margin="0,16,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Text="{Binding Summary}"
                                               Style="{StaticResource SmallText}"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center" />
                                </Grid>

                                <ItemsControl ItemsSource="{Binding Items}" Margin="0,8,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="0,1,0,0"
                                                    Padding="0,12">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel>
                                                        <TextBlock Text="{Binding DisplayName}"
                                                                   Style="{StaticResource BodyText}"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                                        <TextBlock Text="{Binding Description}"
                                                                   Style="{StaticResource SmallText}"
                                                                   Margin="0,2,0,0" />

                                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                            <TextBlock Text="{Binding StatusText}">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource SmallText}">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Status}"
                                                                                         Value="{x:Static enums:ServiceStatus.Habilitado}">
                                                                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Status}"
                                                                                         Value="{x:Static enums:ServiceStatus.Deshabilitado}">
                                                                                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>

                                                            <TextBlock Text="{Binding StartModeText, StringFormat='· {0}'}"
                                                                       Style="{StaticResource SmallText}"
                                                                       Margin="8,0,0,0" />
                                                            <TextBlock Text="{Binding StateText, StringFormat='· {0}'}"
                                                                       Style="{StaticResource SmallText}"
                                                                       Margin="8,0,0,0" />

                                                            <Border Style="{StaticResource DangerBadge}"
                                                                    Margin="10,0,0,0"
                                                                    Visibility="{Binding HighRisk, Converter={StaticResource BoolToVisibility}}">
                                                                <TextBlock Text="Riesgo alto"
                                                                           Style="{StaticResource DangerBadgeText}" />
                                                            </Border>

                                                            <Border Style="{StaticResource WarningBadge}"
                                                                    Margin="6,0,0,0"
                                                                    Visibility="{Binding RequiresRestart, Converter={StaticResource BoolToVisibility}}">
                                                                <TextBlock Text="Requiere reinicio"
                                                                           Style="{StaticResource BadgeText}" />
                                                            </Border>
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <CheckBox Grid.Column="1"
                                                              IsChecked="{Binding IsDisabled}"
                                                              IsEnabled="{Binding CanToggle}"
                                                              Content="Deshabilitar"
                                                              Style="{StaticResource SokToggleSwitch}"
                                                              VerticalAlignment="Center"
                                                              Margin="16,0,0,0" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
