<UserControl x:Class="SOK.UI.Views.MemoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource CardBorder}">
        <StackPanel>
            <TextBlock Text="Liberación de memoria" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="Este módulo se implementará en el Sprint 4: medidor de RAM en tiempo real, liberación manual y liberación automática por umbral."
                       Style="{StaticResource BodyText}"
                       Margin="0,10,0,0" />
        </StackPanel>
    </Border>
</UserControl>
