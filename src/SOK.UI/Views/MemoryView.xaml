<UserControl x:Class="SOK.UI.Views.MemoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="900">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <!-- Encabezado -->
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="SOK mide la memoria RAM del equipo y permite devolver al sistema la memoria retenida por los procesos activos. La operación no cierra aplicaciones ni modifica la configuración persistente de Windows."
                               Style="{StaticResource BodyText}" />
                </StackPanel>
            </Border>

            <!-- Medidor y acciones -->
            <Border Style="{StaticResource CardBorder}" Margin="0,16,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Uso de memoria RAM" Style="{StaticResource BodyText}" />

                        <TextBlock Text="{Binding RamUsagePercent, StringFormat={}{0:0} %}"
                                   Style="{StaticResource MetricValue}"
                                   Margin="0,6,0,0" />

                        <ProgressBar Value="{Binding RamUsagePercent}"
                                     Maximum="100"
                                     Style="{StaticResource SokProgressBar}"
                                     Margin="0,14,0,0" />

                        <TextBlock Text="{Binding RamUsageText}"
                                   Style="{StaticResource BodyText}"
                                   Margin="0,12,0,0" />
                        <TextBlock Text="{Binding RamAvailableText}"
                                   Style="{StaticResource SmallText}"
                                   Margin="0,4,0,0" />
                        <TextBlock Text="{Binding LastUpdatedText}"
                                   Style="{StaticResource SmallText}"
                                   Margin="0,4,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center"
                                Margin="28,0,0,0">
                        <Button Content="Liberar ahora"
                                Command="{Binding ReleaseNowCommand}"
                                Style="{StaticResource PrimaryButton}" />
                        <Button Content="Actualizar medidor"
                                Command="{Binding RefreshNowCommand}"
                                Style="{StaticResource SecondaryButton}"
                                Margin="0,10,0,0" />
                        <TextBlock Text="La liberación vacía el working set de los procesos. Windows vuelve a cargar las páginas que necesiten."
                                   Style="{StaticResource SmallText}"
                                   Margin="0,12,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Estado de la última operación -->
            <Border Style="{StaticResource CardBorder}"
                    Margin="0,16,0,0"
                    Padding="16">
                <StackPanel>
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource BodyText}" />
                    <TextBlock Text="{Binding LastReleaseText}"
                               Style="{StaticResource SmallText}"
                               Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- Liberación automática -->
            <Border Style="{StaticResource CardBorder}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Liberación automática" Style="{StaticResource SectionTitle}" />

                    <TextBlock Text="Cuando el uso de RAM alcance el umbral, SOK liberará memoria automáticamente. El intervalo mínimo entre liberaciones automáticas es de un minuto."
                               Style="{StaticResource BodyText}"
                               Margin="0,6,0,0" />

                    <CheckBox Content="Activar liberación automática"
                              IsChecked="{Binding AutoReleaseEnabled, Mode=TwoWay}"
                              Style="{StaticResource SokToggleSwitch}"
                              Margin="0,16,0,0" />

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Slider Minimum="70"
                                Maximum="95"
                                TickFrequency="1"
                                SmallChange="1"
                                LargeChange="5"
                                IsSnapToTickEnabled="True"
                                Value="{Binding AutoReleaseThreshold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                IsEnabled="{Binding AutoReleaseEnabled}"
                                VerticalAlignment="Center" />

                        <TextBlock Grid.Column="1"
                                   Text="{Binding AutoReleaseThresholdText}"
                                   Style="{StaticResource SectionTitle}"
                                   VerticalAlignment="Center"
                                   Margin="16,0,0,0" />
                    </Grid>

                    <TextBlock Text="Umbral de uso de RAM (70 % a 95 %)"
                               Style="{StaticResource SmallText}"
                               Margin="0,4,0,0" />

                    <TextBlock Text="{Binding AutoReleaseSummaryText}"
                               Style="{StaticResource BodyText}"
                               Margin="0,12,0,0" />
                </StackPanel>
            </Border>

            <!-- Explicación -->
            <Border Style="{StaticResource CardBorder}"
                    Margin="0,16,0,0"
                    Padding="16">
                <StackPanel>
                    <TextBlock Text="¿Qué hace la liberación de memoria?" Style="{StaticResource SectionTitle}" />
                    <TextBlock Style="{StaticResource BodyText}"
                               Margin="0,6,0,0"
                               Text="SOK solicita a Windows que vacíe el working set de cada proceso accesible. Las páginas que no se están usando se mueven a la lista de espera o al archivo de paginación, y los procesos las vuelven a cargar cuando las necesitan. No se cierran aplicaciones ni se pierde información." />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
