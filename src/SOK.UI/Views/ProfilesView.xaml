             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource CardBorder}">
        <StackPanel>
            <TextBlock Text="Perfiles de optimización" Style="{StaticResource SectionTitle}" />
