<UserControl x:Class="SOK.UI.Views.ProfilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="900">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <ScrollViewer x:Name="ContentScroll" VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <!-- Encabezado y acciones -->
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="Un perfil agrupa los ajustes de telemetría, servicios y memoria que SOK aplica de una sola vez. Al aplicar un perfil se crea un respaldo previo de todo lo que se modifica."
                               Style="{StaticResource BodyText}" />

                    <TextBlock Text="{Binding ActiveProfileText}"
                               Style="{StaticResource SectionTitle}"
                               Margin="0,14,0,0" />

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,12,0,0">
                        <Button Content="Actualizar"
                                Command="{Binding RefreshCommand}"
                                Style="{StaticResource SecondaryButton}"
                                Margin="0,0,12,0" />
                        <Button Content="Importar perfil JSON"
                                Command="{Binding ImportProfileCommand}"
                                Style="{StaticResource PrimaryButton}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Estado de la última operación -->
            <Border Style="{StaticResource CardBorder}"
                    Margin="0,16,0,0"
                    Padding="16">
                <StackPanel>
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource BodyText}" />
                    <TextBlock Text="{Binding LastBackupText}"
                               Style="{StaticResource SmallText}"
                               Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- Lista de perfiles -->
            <ItemsControl ItemsSource="{Binding Profiles}" Margin="0,16,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}"
                                                   Style="{StaticResource SectionTitle}" />
                                        <Border Background="{DynamicResource AccentSubtleBrush}"
                                                CornerRadius="4"
                                                Padding="6,2"
                                                Margin="10,0,0,0"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding TypeText}"
                                                       FontFamily="Segoe UI"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AccentBrush}" />
                                        </Border>
                                        <Border Background="{DynamicResource SuccessSubtleBrush}"
                                                CornerRadius="4"
                                                Padding="6,2"
                                                Margin="6,0,0,0"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="Perfil activo"
                                                       FontFamily="Segoe UI"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource SuccessBrush}" />
                                        </Border>
                                    </StackPanel>

                                    <TextBlock Text="{Binding Description}"
                                               Style="{StaticResource BodyText}"
                                               Margin="0,6,0,0" />
                                </StackPanel>

                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            Margin="16,0,0,0">
                                    <Button Content="{Binding ActivateButtonText}"
                                            Command="{Binding DataContext.ActivateProfileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource SecondaryButton}"
                                            Margin="0,0,8,0" />
                                    <Button Content="Aplicar"
                                            Command="{Binding DataContext.ApplyProfileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource PrimaryButton}"
                                            Margin="0,0,8,0" />
                                    <Button Content="Exportar"
                                            Command="{Binding DataContext.ExportProfileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource SecondaryButton}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Criterio de los perfiles base -->
            <Border Style="{StaticResource CardBorder}"
                    Margin="0,4,0,0"
                    Padding="16">
                <StackPanel>
                    <TextBlock Text="Cómo se crean los perfiles" Style="{StaticResource SectionTitle}" />
                    <TextBlock Style="{StaticResource BodyText}"
                               Margin="0,6,0,0"
                               Text="Los perfiles Gamer y Ofimático vienen incluidos y se completan automáticamente a partir de los catálogos de SOK. Los perfiles personalizados solo se incorporan importando un archivo JSON válido; este sprint no incluye un editor manual de perfiles." />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
