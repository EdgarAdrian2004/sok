<UserControl x:Class="SOK.UI.Views.TutorialView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="900">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:StepStateToBrushConverter x:Key="StepStateToBrushConverter" xmlns:converters="clr-namespace:SOK.UI.Converters" />
        <converters:StepStateToTextConverter x:Key="StepStateToTextConverter" xmlns:converters="clr-namespace:SOK.UI.Converters" />
        <converters:IndexToProgressConverter x:Key="IndexToProgressConverter" xmlns:converters="clr-namespace:SOK.UI.Converters" />

        <Style x:Key="StepListBoxItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Root"
                                Background="Transparent"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource SurfaceSubtleBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Índice de pasos -->
        <Border Grid.Column="0"
                Style="{StaticResource CardBorder}"
                Margin="0,0,16,0"
                Padding="14">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="6,4,6,12">
                    <TextBlock Text="Guía paso a paso" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="{Binding ProgressText}"
                               Style="{StaticResource SmallText}"
                               Margin="0,4,0,0" />
                </StackPanel>

                <ListBox ItemsSource="{Binding Steps}"
                         SelectedIndex="{Binding CurrentIndex, Mode=TwoWay}"
                         ItemContainerStyle="{StaticResource StepListBoxItem}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="24"
                                        Height="24"
                                        CornerRadius="12"
                                        VerticalAlignment="Top">
                                    <Border.Background>
                                        <MultiBinding Converter="{StaticResource StepStateToBrushConverter}">
                                            <Binding Path="Order" />
                                            <Binding Path="DataContext.CurrentIndex" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                        </MultiBinding>
                                    </Border.Background>
                                    <TextBlock FontFamily="Segoe UI Variable Text, Segoe UI"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="White"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center">
                                        <TextBlock.Text>
                                            <MultiBinding Converter="{StaticResource StepStateToTextConverter}">
                                                <Binding Path="Order" />
                                                <Binding Path="DataContext.CurrentIndex" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </Border>
                                <TextBlock Text="{Binding Title}"
                                           FontFamily="Segoe UI Variable Text, Segoe UI"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           TextWrapping="Wrap"
                                           Margin="8,3,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Contenido del paso -->
        <Border Grid.Column="1" Style="{StaticResource CardBorder}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="24,20,24,8">
                    <TextBlock Text="{Binding CurrentStep.Title}"
                               Style="{StaticResource PageTitle}"
                               FontSize="20" />
                    <TextBlock Text="{Binding ProgressText}"
                               Style="{StaticResource SmallText}"
                               Margin="0,4,0,12" />
                    <ProgressBar Value="{Binding CurrentIndex, Converter={StaticResource IndexToProgressConverter}}"
                                 Maximum="{Binding Steps.Count}"
                                 Style="{StaticResource SokProgressBar}"
                                 Height="6" />
                </StackPanel>

                <FlowDocumentScrollViewer x:Name="StepViewer"
                                          Grid.Row="1"
                                          Margin="24,4,24,8"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          IsToolBarVisible="False"
                                          Background="Transparent" />

                <Border Grid.Row="2"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="24,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Button Content="Anterior"
                                    Command="{Binding PreviousCommand}"
                                    Style="{StaticResource SecondaryButton}" />
                            <Button Content="{Binding ModuleButtonText}"
                                    Command="{Binding GoToModuleCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    Margin="10,0,0,0"
                                    Visibility="{Binding HasModule, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding StatusMessage}"
                                   Style="{StaticResource SmallText}"
                                   VerticalAlignment="Center"
                                   TextAlignment="Center"
                                   Margin="16,0" />

                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button Content="Saltar tutorial"
                                    Command="{Binding SkipCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    Margin="0,0,10,0" />
                            <Button Content="Siguiente"
                                    Command="{Binding NextCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    Visibility="{Binding IsNotLastStep, Converter={StaticResource BoolToVisibility}}" />
                            <Button Content="Finalizar"
                                    Command="{Binding CompleteCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    Visibility="{Binding IsLastStep, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
