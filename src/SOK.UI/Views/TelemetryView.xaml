<UserControl x:Class="SOK.UI.Views.TelemetryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:enums="clr-namespace:SOK.Domain.Enums;assembly=SOK.Domain"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="900">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <!-- Encabezado y acciones -->
            <Border Style="{StaticResource CardBorder}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Telemetría y privacidad" Style="{StaticResource PageTitle}" />
                        <TextBlock Text="SOK revisa las claves de telemetría y privacidad de Windows. Antes de aplicar cualquier cambio se crea un respaldo del registro con su hash SHA-256."
                                   Style="{StaticResource BodyText}"
                                   Margin="0,8,0,0" />
                        <TextBlock Text="{Binding SummaryText}"
                                   Style="{StaticResource SectionTitle}"
                                   Margin="0,14,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="16,0,0,0">
                        <ComboBox ItemsSource="{Binding Categories}"
                                  SelectedItem="{Binding SelectedCategory}"
                                  Width="190"
                                  Height="34"
                                  Margin="0,0,12,0" />
                        <Button Content="Actualizar"
                                Command="{Binding RefreshCommand}"
                                Style="{StaticResource SecondaryButton}"
                                Margin="0,0,12,0" />
                        <Button Content="Privacidad máxima"
                                Command="{Binding ApplyMaxPrivacyCommand}"
                                Style="{StaticResource PrimaryButton}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Estado de la última operación -->
            <Border Style="{StaticResource CardBorder}"
                    Margin="0,16,0,0"
                    Padding="16">
                <StackPanel>
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource BodyText}" />
                    <TextBlock Text="{Binding LastBackupText}"
                               Style="{StaticResource SmallText}"
                               Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- Catálogo agrupado por categoría -->
            <ItemsControl ItemsSource="{Binding Groups}" Margin="0,16,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Text="{Binding Summary}"
                                               Style="{StaticResource SmallText}"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center" />
                                </Grid>

                                <ItemsControl ItemsSource="{Binding Items}" Margin="0,8,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="0,1,0,0"
                                                    Padding="0,12">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel>
                                                        <TextBlock Text="{Binding DisplayName}"
                                                                   Style="{StaticResource BodyText}"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                                        <TextBlock Text="{Binding Description}"
                                                                   Style="{StaticResource SmallText}"
                                                                   Margin="0,2,0,0" />

                                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                            <TextBlock Text="{Binding StatusText}">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource SmallText}">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Status}"
                                                                                         Value="{x:Static enums:TelemetryStatus.Habilitado}">
                                                                                <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Status}"
                                                                                         Value="{x:Static enums:TelemetryStatus.Deshabilitado}">
                                                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>

                                                            <Border Style="{StaticResource WarningBadge}"
                                                                    Margin="10,0,0,0"
                                                                    Visibility="{Binding RequiresRestart, Converter={StaticResource BoolToVisibility}}">
                                                                <TextBlock Text="Requiere reinicio"
                                                                           Style="{StaticResource BadgeText}" />
                                                            </Border>
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <CheckBox Grid.Column="1"
                                                              IsChecked="{Binding IsDisabled}"
                                                              Content="Deshabilitar"
                                                              Style="{StaticResource SokToggleSwitch}"
                                                              VerticalAlignment="Center"
                                                              Margin="16,0,0,0" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
