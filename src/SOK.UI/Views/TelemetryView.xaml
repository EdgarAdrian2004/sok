<UserControl x:Class="SOK.UI.Views.TelemetryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource CardBorder}">
        <StackPanel>
            <TextBlock Text="Telemetría y privacidad" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="Este módulo se implementará en el Sprint 2: listado de telemetrías, interruptores individuales y modo de privacidad máxima."
                       Style="{StaticResource BodyText}"
                       Margin="0,10,0,0" />
        </StackPanel>
    </Border>
</UserControl>
