<UserControl x:Class="SOK.UI.Views.BackupsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="900">

    <ScrollViewer x:Name="ContentScroll" VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <!-- Encabezado y acciones -->
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="SOK verifica el hash SHA-256 de cada respaldo antes de restaurarlo. La restauración devuelve las claves de registro y los servicios a su estado anterior; los cambios de telemetría pueden requerir reiniciar Windows."
                               Style="{StaticResource BodyText}" />

                    <TextBlock Text="{Binding SummaryText}"
                               Style="{StaticResource SectionTitle}"
                               Margin="0,14,0,0" />

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,12,0,0">
                        <Button Content="Actualizar"
                                Command="{Binding RefreshCommand}"
                                Style="{StaticResource SecondaryButton}"
                                Margin="0,0,12,0" />
                        <Button Content="Restaurar seleccionado"
                                Command="{Binding RestoreCommand}"
                                Style="{StaticResource PrimaryButton}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Estado de la última operación -->
            <Border Style="{StaticResource CardBorder}"
                    Margin="0,16,0,0"
                    Padding="16">
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource BodyText}" />
            </Border>

            <!-- Lista de respaldos -->
            <ItemsControl ItemsSource="{Binding Backups}" Margin="0,16,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}"
                                                   Style="{StaticResource SectionTitle}" />
                                        <Border Background="{DynamicResource AccentSubtleBrush}"
                                                CornerRadius="4"
                                                Padding="6,2"
                                                Margin="10,0,0,0"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding TypeText}"
                                                       FontFamily="Segoe UI Variable Text, Segoe UI"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AccentBrush}" />
                                        </Border>
                                    </StackPanel>

                                    <TextBlock Text="{Binding DateText, StringFormat='Fecha: {0}'}"
                                               Style="{StaticResource SmallText}"
                                               Margin="0,6,0,0" />

                                    <TextBlock Text="{Binding Description}"
                                               Style="{StaticResource BodyText}"
                                               Margin="0,6,0,0" />

                                    <TextBlock Text="{Binding IntegrityText}"
                                               Margin="0,6,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource SmallText}">
                                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsIntegrityOk}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>

                                <Button Grid.Column="1"
                                        Content="{Binding RestoreButtonText}"
                                        Command="{Binding DataContext.RestoreCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        IsEnabled="{Binding CanRestore}"
                                        Style="{StaticResource PrimaryButton}"
                                        VerticalAlignment="Center"
                                        Margin="16,0,0,0" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Nota sobre el alcance -->
            <Border Style="{StaticResource CardBorder}"
                    Margin="0,4,0,0"
                    Padding="16">
                <StackPanel>
                    <TextBlock Text="Alcance de la restauración" Style="{StaticResource SectionTitle}" />
                    <TextBlock Style="{StaticResource BodyText}"
                               Margin="0,6,0,0"
                               Text="Se restauran las claves de registro y el tipo de inicio de los servicios incluidos en el respaldo. No se restaura el estado de ejecución de los servicios ni la lista de standby de memoria: esas acciones quedan fuera del alcance del sprint." />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
