<UserControl x:Class="SOK.UI.Views.BackupsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource CardBorder}">
        <StackPanel>
            <TextBlock Text="Respaldos y restauración" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="El Sprint 1 ya genera respaldos completos desde el panel de control. La restauración y el historial detallado se completan en el Sprint 5."
                       Style="{StaticResource BodyText}"
                       Margin="0,10,0,0" />
        </StackPanel>
    </Border>
</UserControl>
